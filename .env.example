# Copy to .env and fill in. NEVER commit .env.

# Anthropic API key for resume tailoring (required for `tailor` only)
ANTHROPIC_API_KEY=sk-ant-...

# Database. Defaults to local SQLite if unset.
# Postgres (docker-compose): postgresql+psycopg2://jobagent:jobagent@localhost:5432/jobagent
DATABASE_URL=sqlite:///./jobagent.db

# Required for public deploys (Vercel): HTTP Basic auth password for all routes.
# Leave empty for local use (no auth).
DASHBOARD_PASSWORD=

# Owner identity for the single-tenant Basic-auth provider (any value)
OWNER_EMAIL=you@example.com

# Embeddings for profile/job matching. auto = Voyage if key set, else local
# sentence-transformers if installed, else a low-quality hashing fallback.
EMBEDDING_PROVIDER=auto
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3-lite

# Vertical configuration (domain data lives in config/vertical/<name>/)
VERTICAL=ai

# Claude model used for tailoring and resume parsing
CLAUDE_MODEL=claude-sonnet-4-6

# Paths (defaults shown)
RESUME_PATH=data/resume.md
TARGETS_PATH=data/targets.yaml

# Embedding model for matching (requires `pip install -e .[ml]`).
# If sentence-transformers is not installed, a TF-IDF fallback is used.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
